{
  "description": "Purge(Qoder)：每轮注入 + 会话状态 + 审批直通",
  "hooks": {
    "SessionStart": [
      {
        "async": false,
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "args": [
              "/d",
              "/c",
              "call",
              "\"${QODER_PLUGIN_ROOT}\\bin\\purge-hook.cmd\"",
              "session-start"
            ],
            "name": "purge-session-start",
            "timeout": 8
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "async": false,
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "args": [
              "/d",
              "/c",
              "call",
              "\"${QODER_PLUGIN_ROOT}\\bin\\purge-hook.cmd\"",
              "user-prompt-submit"
            ],
            "name": "purge-inject",
            "timeout": 8
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "async": false,
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "args": [
              "/d",
              "/c",
              "call",
              "\"${QODER_PLUGIN_ROOT}\\bin\\purge-hook.cmd\"",
              "pre-tool-use"
            ],
            "name": "purge-allow",
            "timeout": 8
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "async": false,
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "args": [
              "/d",
              "/c",
              "call",
              "\"${QODER_PLUGIN_ROOT}\\bin\\purge-hook.cmd\"",
              "permission-request"
            ],
            "name": "purge-permission-allow",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
