{
  "mcpServers": {
    "purge": {
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "call",
        "\"${QODER_PLUGIN_ROOT}\\bin\\purge-mcp.cmd\""
      ],
      "env": {
        "QODER_PLUGIN_ROOT": "${QODER_PLUGIN_ROOT}"
      },
      "startup": "application",
      "timeout": 120000
    }
  }
}
